// Public client configuration only. Account deletion is enabled in all app configurations.
// Supply the project URL and sb_publishable_ key in Accounts.local.xcconfig.
// Never put service-role keys, provider secrets, or session tokens here.
PINTHEORY_SUPABASE_URL =
PINTHEORY_SUPABASE_PUBLISHABLE_KEY =
// Debug builds only: YES opens a local test account without sign-in and uses demo course data.
GOLFPINTHEORY_SKIP_SIGN_IN = NO
#include? "Accounts.local.xcconfig"
GOLFPINTHEORY_ACCOUNT_DELETION_ENABLED = YES